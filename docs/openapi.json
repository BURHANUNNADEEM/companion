    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "parameters": [
     {
      "name": "hour",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 23,
         "minimum": 0
        },
        {
         "type": "null"
        }
       ],
       "title": "Hour"
      }
     },
     {
      "name": "last_task",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 32
        },
        {
         "type": "null"
        }
       ],
       "title": "Last Task"
      }
     },
     {
      "name": "k",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 3,
       "minimum": 1,
       "default": 3,
       "title": "K"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
