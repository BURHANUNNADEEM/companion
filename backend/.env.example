# ---------------------------------------------------------------
# Companion backend configuration. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------

# development | test | production   (production refuses AUTH_MODE=dev and the default ADMIN_TOKEN)
ENV=development
CORS_ORIGINS=*

# --- Database -------------------------------------------------
# Neon (free tier): copy the connection string from the Neon console. sslmode is handled automatically.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Local quick start without Postgres:
DATABASE_URL=sqlite+aiosqlite:///./companion.db

# --- Auth (F5) ------------------------------------------------
# firebase = verify Firebase ID tokens (real login). dev = accept "dev:<uid>[:<email>]" tokens (local demo only).
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# Service account JSON: a file path, the raw JSON, or base64 of the JSON
# (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_CREDENTIALS=

# --- LLM: Gemini (F8) -----------------------------------------
# Free key: https://aistudio.google.com/apikey . App works fully with LLM_ENABLED=false (rule-based fallback).
# Free-tier prompts may be used by Google to improve products: demo with synthetic/consenting data only.
LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
LLM_TIMEOUT_SECONDS=6
LLM_RATE_PER_MINUTE=10
LLM_MIN_CONFIDENCE=0.6

# --- Struggle detection (F2): change without a code change; served to the app by GET /api/config ---
STRUGGLE_THRESHOLD=0.8
STRUGGLE_W_BACKTRACKING=0.8
STRUGGLE_W_IDLE=0.5
STRUGGLE_W_REPEATED_TAPS=0.8
STRUGGLE_W_LOOPING=0.6
STRUGGLE_W_NO_COMPLETION=0.4
STRUGGLE_BACK_COUNT=3
STRUGGLE_BACK_WINDOW_S=20
STRUGGLE_IDLE_S=10
STRUGGLE_REPEAT_TAPS=3
STRUGGLE_REPEAT_WINDOW_S=5
STRUGGLE_LOOP_VISITS=3
STRUGGLE_NO_COMPLETION_S=45
STRUGGLE_COOLDOWN_S=60

# --- Suggestions (F3) -----------------------------------------
SUGGESTION_BACKOFF_DISMISSALS=3
SUGGESTION_BACKOFF_MINUTES=30

# --- Caregiver (F9) -------------------------------------------
INVITE_TTL_HOURS=24
INACTIVITY_DAYS_DEFAULT=2
REPEATED_STRUGGLE_ALERT_COUNT=3
# Protects POST /api/alerts/inactivity/run (call daily from cron / GitHub Actions)
ADMIN_TOKEN=change-me

# --- Email (F9 invites) ---------------------------------------
# console = print to log and return the code in the API response (dev only). smtp = real e-mail.
EMAIL_BACKEND=console
# Gmail: enable 2-step verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Companion <your.address@gmail.com>
SMTP_USE_TLS=true
APP_INVITE_URL=https://companion.example/invite
