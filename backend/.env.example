# Neon dashboard -> Connect -> copy the pooled connection string,
# then change the prefix to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Fill these in at the Clerk step
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=