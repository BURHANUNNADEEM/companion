# ---------- Database (Neon) ----------
# Neon dashboard -> Connect -> copy the pooled connection string,
# then change the prefix to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ---------- Auth (Firebase) ----------
FIREBASE_PROJECT_ID=your-project-id
# Local testing only: lets "Authorization: Bearer dev-alice" work without Firebase. NEVER true in prod.
DEV_AUTH_ENABLED=false

# ---------- App ----------
APP_ENV=dev
# Comma-separated origins, or * (the Flutter mobile app does not need CORS; this is for web/Swagger tools)
CORS_ORIGINS=*

# ---------- Gemini (optional; app works without it, rules are the fallback) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=8

# ---------- Struggle detection thresholds (optional overrides) ----------
# STRUGGLE_IDLE_MIN_S=8
# STRUGGLE_IDLE_MAX_S=20
# STRUGGLE_TRIGGER_THRESHOLD=1.0
# LADDER_CLEAN_FOR_NONE=3
